    function saveLocalAutosave() {
      if (selectExisting?.value !== "__new__") return;
      const state = {
        title: metaTitle?.value || "",
        slug: metaSlug?.value || "",
        category: metaCategory?.value || "Notes",
        date: metaDate?.value || todayStr,
        tags: metaTags?.value || "",
        summary: metaSummary?.value || "",
        body: editor?.value || "",
      };
      localStorage.setItem(STORAGE_DRAFT_KEY, JSON.stringify(state));
    }

    const restoreAutosaveOrUrlSlug = () => {
      const params = new URLSearchParams(window.location.search);
      const urlSlug = params.get("slug");
      if (urlSlug) {
        fetchExistingPosts(urlSlug);
        return;
      }

      fetchExistingPosts();
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_DRAFT_KEY) || "null");
        if (saved && (saved.title || saved.body)) {
          if (metaTitle) metaTitle.value = saved.title || "";
          if (metaSlug) metaSlug.value = saved.slug || "";
          if (metaCategory) metaCategory.value = saved.category || "Notes";
