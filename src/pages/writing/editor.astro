          if (metaTags) metaTags.value = saved.tags || "";
          if (metaSummary) metaSummary.value = saved.summary || "";
          if (editor) editor.value = saved.body || "";
          renderPreview();
          return;
        }
      } catch {}

      renderPreview();
    };

