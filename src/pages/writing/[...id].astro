---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { estimateReadingTime, formatDate, getWriting, slugify } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getWriting();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const minutes = estimateReadingTime(post.body);
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  active="writing"
  image={post.data.cover}
  type="article"
>
  <article class="article-shell shell">
    <header class="article-header">
      <div class="writing-card-topline">
        <a class="category-label" href={`/writing/category/${slugify(post.data.category)}/`}>{post.data.category}</a>
        {post.data.demo && <span class="demo-label">Demo</span>}
        {post.data.draft && <span class="draft-label">Local draft</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-summary">{post.data.summary}</p>
      <div class="writing-meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span>{minutes} min read</span>
      </div>
      <div class="tag-row">
        {post.data.tags.map((tag) => <a href={`/writing/tag/${slugify(tag)}/`}>#{tag}</a>)}
      </div>
    </header>

    {post.data.cover && (
      <figure class="article-cover">
        <img src={post.data.cover} alt={post.data.coverAlt ?? ""} loading="eager" />
      </figure>
    )}

    {tocHeadings.length > 0 && (
      <details class="mobile-toc">
        <summary>On this page</summary>
        <nav aria-label="Article table of contents">
          {tocHeadings.map((heading) => (
            <a class={`toc-depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>
          ))}
        </nav>
      </details>
    )}

    <div class="article-grid">
      <div class="prose"><Content /></div>
      {tocHeadings.length > 0 && (
        <aside class="article-toc">
          <p>On this page</p>
          <nav aria-label="Article table of contents">
            {tocHeadings.map((heading) => (
              <a class={`toc-depth-${heading.depth}`} href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          </nav>
        </aside>
      )}
    </div>
  </article>
</BaseLayout>
