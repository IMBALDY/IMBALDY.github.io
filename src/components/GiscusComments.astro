---
/**
 * Giscus academic comment section with native LaTeX ($...$ and $$...$$) support.
 * Configured for `IMBALDY/IMBALDY.github.io` (repoId: R_kgDOQX1Vgw, General categoryId: DIC_kwDOQX1Vg84DKdmv).
 */
interface Props {
  repo?: string;
  repoId?: string;
  category?: string;
  categoryId?: string;
}

const {
  repo = "IMBALDY/IMBALDY.github.io",
  repoId = "R_kgDOQX1Vgw",
  category = "General",
  categoryId = "DIC_kwDOQX1Vg84DKdmv",
} = Astro.props;
---

<section class="article-comments" aria-label="Comments and academic discussion">
  <div class="comments-header">
    <div>
      <p class="eyebrow">Academic Discussion</p>
      <h2>Comments &amp; Derivations</h2>
    </div>
    <p class="comments-tip">
      Supports Markdown &amp; LaTeX math (use <code>$...$</code> for inline and <code>$$...$$</code> for block equations).
    </p>
  </div>

  <div id="giscus-wrapper">
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="light"
      data-lang="zh-CN"
      crossorigin="anonymous"
      async
    ></script>
  </div>
</section>
